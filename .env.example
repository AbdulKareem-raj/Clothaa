# ─────────────────────────────────────────────
# Northline — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────

# ── Database (PostgreSQL — e.g. Neon.tech) ──
# Neon par free project banao → connection string yahan paste karo
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth (Auth.js v5) ──
# Secret generate karo:  npx auth secret   (ya openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (Nodemailer + Gmail SMTP) ──
# Gmail "App Password" use karo (normal password nahi).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
EMAIL_FROM="Northline <your-gmail@gmail.com>"
# Admin notifications (contact form, new orders) yahan aayenge:
ADMIN_EMAIL="your-gmail@gmail.com"

# ── Cloudinary (image + video upload) ──
# cloudinary.com par free account → Dashboard se values lo
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ── Mixpanel (user activity tracking) ──
# mixpanel.com par project banao → Project Token
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-project-token"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (card payments — required for checkout) ──
# stripe.com → Developers → API keys. Test mode keys se start karo.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret:
#  - Local dev:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
#  - Production: Stripe Dashboard → Webhooks → endpoint /api/webhooks/stripe
#    (event: checkout.session.completed) → "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── First admin account (create:admin script use karta hai) ──
ADMIN_SEED_EMAIL="admin@northline.com"
ADMIN_SEED_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_SEED_NAME="Store Admin"
